# =========================================================================
# 🟢 EXPANSÃO MESTRE DE MEMÓRIA PARA REELS E FOTOS PREMIUM (GRUPO AURÉLIUS)
# =========================================================================
php_value upload_max_filesize 256M
php_value post_max_size 256M
php_value memory_limit 512M
php_value max_execution_time 600
php_value max_input_time 600

# =========================================================================
# 🔀 DIRETIVAS DE REDIRECIONAMENTO E MÁSCARA DE ROTAS LINUX
# =========================================================================
DirectoryIndex Principal.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Se tentar aceder à raiz ou index.html, força o carregamento do Principal.php
    RewriteRule ^$ Principal.php [L]
    RewriteRule ^index\.html$ Principal.php [NC,R=301,L]

    # 🟢 PROTEÇÃO ANTI-404: Remove a necessidade de digitar .php na URL
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]
</IfModule>